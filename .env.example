# Copy to .env.local for local development. Every setting is optional.

# Turns on AI photo recognition in the scanner (Claude, by Anthropic).
# Without it, the scanner matches typed descriptions on the device.
ANTHROPIC_API_KEY=

# Model used for photo recognition. Defaults to claude-opus-5-5.
FIXIT_AI_MODEL=

# The site's public URL, used for link previews. Set automatically on Vercel.
NEXT_PUBLIC_SITE_URL=
